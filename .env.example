# ============================================================================
# TEAM-SSO ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains ALL environment variables required for the application.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control - passwords are stored in Google Secret Manager.
# ============================================================================

# ----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite - prefix with VITE_)
# ----------------------------------------------------------------------------

# Google OAuth Client ID for authentication
# Get from: Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Setup instructions: docs/setup/AUTHENTICATION_SETUP.md
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Backend API URL
# Development: http://localhost:3000
# Production: Your Cloud Run URL
VITE_API_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# BACKEND CONFIGURATION (server/.env)
# ----------------------------------------------------------------------------

# === DATABASE CONFIGURATION ===
# PostgreSQL connection details
# For local development: 127.0.0.1:5432
# For production: Use Cloud SQL connection or proxy

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=startup_scout
DB_USER=postgres
# DB_PASSWORD is stored in Google Secret Manager for production
# For local: set your local PostgreSQL password
DB_PASSWORD=your_local_postgres_password

# Cloud SQL Connection (for production with cloud-sql-proxy)
# Format: project-id:region:instance-name
CLOUD_SQL_CONNECTION_NAME=your-project-id:us-central1:your-instance-name

# === GOOGLE CLOUD CONFIGURATION ===

# Google Cloud Project ID
# Get from: Google Cloud Console → Project Info
GCP_PROJECT_ID=your-gcp-project-id

# Google Application Credentials (Service Account Key)
# Path to service account JSON file
# Download from: Google Cloud Console → IAM & Admin → Service Accounts
# Required permissions: Cloud SQL Client, Secret Manager Accessor, Vertex AI User
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# === GOOGLE GEMINI AI CONFIGURATION ===

# Gemini API Key (for standard Gemini API)
# Get from: https://aistudio.google.com/app/apikey
# Used for: PDF analysis, audio transcription, PowerPoint extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Vertex AI Configuration (optional - for grounding/web search)
# Region where Vertex AI models are deployed
VERTEX_AI_REGION=us-central1

# Vertex AI Model (if using Vertex AI instead of standard Gemini API)
# Options: gemini-1.5-flash-002, gemini-1.5-pro-002
VERTEX_AI_MODEL=gemini-1.5-flash-002

# === SERVER CONFIGURATION ===

# Server port
PORT=3000

# Node environment
# Options: development, production, test
NODE_ENV=development

# Frontend URL (for CORS)
# Development: http://localhost:5173
# Production: Your Vercel/frontend URL
FRONTEND_URL=http://localhost:5173

# === FILE UPLOAD CONFIGURATION ===

# Maximum file size (in bytes)
# Default: 104857600 (100MB)
MAX_FILE_SIZE=104857600

# Upload directory (relative to server root)
UPLOAD_DIR=./uploads

# Temporary directory (for report generation)
TEMP_DIR=./temp

# === FEATURE FLAGS ===

# Enable Vertex AI Grounding (web search)
# Options: true, false
# Requires Vertex AI setup
ENABLE_GROUNDING=false

# Enable web enrichment in reports
# Options: true, false
ENABLE_WEB_ENRICHMENT=true

# Enable dual PDF comparison feature
# Options: true, false
ENABLE_DUAL_PDF=true

# === LOGGING & MONITORING ===

# Log level
# Options: error, warn, info, debug
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# === SECURITY CONFIGURATION ===

# JWT Secret (for session tokens)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Session expiry (in seconds)
# Default: 86400 (24 hours)
SESSION_EXPIRY=86400

# CORS allowed origins (comma-separated)
# Add your frontend URLs
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# === RATE LIMITING ===

# Rate limit window (in minutes)
RATE_LIMIT_WINDOW=15

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------------------------
# GOOGLE SECRET MANAGER SECRETS (Production Only)
# ----------------------------------------------------------------------------
# These are NOT environment variables - they're stored in Google Secret Manager
# Access them via: gcloud secrets versions access latest --secret="secret-name"
#
# Required secrets:
# 1. db-password          → PostgreSQL password
# 2. gemini-api-key       → Gemini API key
# 3. jwt-secret           → JWT signing secret
# 4. service-account-key  → Service account JSON (entire file)
#
# Setup instructions: docs/setup/GOOGLE_CLOUD_SETUP.md
# ----------------------------------------------------------------------------

# ============================================================================
# SETUP CHECKLIST
# ============================================================================
# [ ] Create Google Cloud Project
# [ ] Enable APIs: Cloud SQL, Secret Manager, Vertex AI, Gemini
# [ ] Create Cloud SQL PostgreSQL instance
# [ ] Create service account with required permissions
# [ ] Download service account key JSON
# [ ] Store secrets in Secret Manager (production)
# [ ] Setup OAuth 2.0 credentials
# [ ] Configure Authorized domains
# [ ] Copy this file to .env
# [ ] Fill in all values
# [ ] Run database migrations: node server/migrate.js
# [ ] Test locally: npm run dev
# ============================================================================