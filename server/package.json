{
  "name": "team-sso-server",
  "version": "2.0.0",
  "description": "Backend API for Team-SSO - AI-Powered Pitch Deck Analysis Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node -r tsx/register src/db/migrate.ts",
    "db:seed": "node -r tsx/register src/db/seed.ts",
    "populate-sectors": "tsx populate-sectors.ts"
  },
  "keywords": [
    "vc",
    "venture-capital",
    "pitch-deck",
    "ai-analysis",
    "google-gemini",
    "startup"
  ],
  "author": "Team-SSO",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/speech": "^7.2.1",
    "@google-cloud/vertexai": "^1.10.0",
    "@google/generative-ai": "^0.24.1",
    "@notionhq/client": "^5.4.0",
    "@types/ioredis": "^4.28.10",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "googleapis": "^166.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pptx2json": "^0.0.10",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.1",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.10",
    "@types/node": "^20.9.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.6.2",
    "typescript": "^5.2.2"
  }
}
